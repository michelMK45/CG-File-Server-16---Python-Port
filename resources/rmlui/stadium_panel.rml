<rml>
<head>
<style>
body {
    display: block;
    position: absolute;
    top: 20px;
    width: 460px;
    height: 140px;
    background-color: #101828EE;
    border: 1px #3399FF;
    border-top: 3px #3399FF;
    font-family: "Segoe UI";
}
#imgbox {
    display: block;
    position: absolute;
    left: 12px;
    top: 16px;
    width: 110px;
    height: 88px;
    background-color: #0C1420;
    text-align: center;
    vertical-align: middle;
}
#imgbox img { max-width: 110px; max-height: 88px; }
#textcol { display: block; position: absolute; left: 136px; top: 14px; width: 312px; }
#title { display: block; font-size: 17px; color: #3399FF; margin-bottom: 8px; }
#name { display: block; font-size: 16px; font-weight: bold; color: #FFFFFF; margin-bottom: 6px; }
#detail { display: block; font-size: 13px; color: #99BBDD; margin-bottom: 8px; }
#progress-track {
    display: block;
    position: absolute;
    left: 136px;
    bottom: 12px;
    width: 312px;
    height: 10px;
    background-color: #222C3C;
}
#progress-fill { display: block; height: 10px; width: 0%; background-color: #3399FF; }
</style>
</head>
<body>
<div id="imgbox"><img id="preview-img" style="display: none;" /></div>
<div id="textcol">
<div id="title">Loading Stadium</div>
<div id="name"></div>
<div id="detail"></div>
</div>
<div id="progress-track"><div id="progress-fill"></div></div>
</body>
</rml>
