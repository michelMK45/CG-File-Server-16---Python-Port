# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Build outputs
build/
dist/
*.spec.bak

# Logs and runtime-generated files
runtime/server16.log
runtime/*.log

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# 32-bit Python embeddable (generated by scripts/setup_python32.bat)
bin/python32/

# Vendored RmlUi source (cloned by scripts/setup_rmlui_thirdparty.bat)
server16_py/d3d_overlay/thirdparty/

# Local packaging leftovers
*.toc
*.pkg
*.pyz
*.manifest

# PyInstaller temp data
localpycs/

# MSVC / C++ build artifacts
*.obj
*.pdb
*.ilk
*.exp
*.lib

# Local build output duplicate — the shipped copy lives in bin/, only the
# C# source (KitExtractorHost.cs, build.bat) is tracked here.
server16_py/native_tools/kit_extractor/KitExtractorHost.exe

# Claude Code — shared project config is tracked (CLAUDE.md, .claude/settings.json,
# .claude/agents, .claude/skills, .claude/rules); personal / machine-specific files are not.
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
.claude/**/__pycache__/
# Maintainer's local context docs (bug histories, forum reports) referenced from CLAUDE.md
docs/*.md
docs/history/

# Local game-assignment data written by the app when run from source — the
# shipped template is install_data/FSW/, which stays tracked.
/FSW/
