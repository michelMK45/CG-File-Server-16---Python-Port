						,{"event":"AdvanceCareer","actions":[["sendScreenEvent", ["CareerAdvance"]],["sendScreenEvent", ["UxSetFlowSubState", ".eSubState.UNLOADING"]],["sendAction", ["quit"]]],"targets":["CareerMatchResults"]}	
