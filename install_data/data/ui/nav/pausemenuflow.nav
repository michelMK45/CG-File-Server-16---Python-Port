{
	"name":"pauseMenuFlow"
	,"initial":
	{
		"targets":["PMASkillGameCheck"]
	}
	,"onEnter":
	[
		["sendAction", ["backendEnter"]]
		,["loadViewModel", ["InGameFlowViewModel"]]
	]
	,"onExit":
	[
		["unloadViewModel", ["InGameFlowViewModel"]]
		,["sendAction", ["backendExit"]]
		,["sendAction",["navigationBackoutContinue"]]
	]
	,"transitions":
	[
		{ "event":"navigationBackoutStart" }
		,{ "event":"pause", "targets":["PauseMenu"], "let":{ "isGamePaused": "1" } }
		,{ "event":"ContinueNextOnlineMatch", "actions": [["sendScreenEvent", ["ResetActiveController",""]],["sendScreenEvent", ["UxSetFlowState",".eState.ARENA"]],["sendScreenEvent", ["UxSetFlowSubState",".eSubState.SUBSTATE_NONE"]]], "targets":["continue"] }
		,{ "event":"evt_online_disconnect", "targets":["ConnectionWithOpponentLostPopup"] }
		,{ "event":"evt_online_disconnect_eom", "targets":["ConnectionWithOpponentLostEomPopup"] }
		,{ "event":"evt_online_disconnect_mismatching_squad", "targets":["MismatchingSquadPopup"] }
		,{ "event":"evt_online_disconnect_mismatching_squad_eom", "targets":["MismatchingSquadEomPopup"] }
		,{ "event":"evt_online_disconnect_idle_player", "targets":["IdlePlayerPopup"] }
		,{ "event":"evt_online_disconnect_idle_player_eom", "targets":["IdlePlayerEomPopup"] }
		,{ "event":"evt_online_disconnect_mismatching_changelist", "targets":["MismatchingChangelistPopup"] }
		,{ "event":"evt_online_disconnect_mismatching_changelist_eom", "targets":["MismatchingChangelistEomPopup"] }
		,{ "event":"evt_online_desync", "targets":["OnlineDesyncPopup"] }
		,{ "event":"evt_kick_from_otp_captain_kick", "targets":["KickFromOtp_CaptainKick"] }
		,{ "event":"evt_kick_from_otp_clubs_forfeit", "targets":["KickFromOtp_ClubsForfeit"] }
		,{ "event":"evt_kick_from_otp_clubs_opponent_forfeit", "targets":["KickFromOtp_ClubsOpponentForfeit"] }
		,{ "event":"evt_kick_from_otp_coop_forfeit", "targets":["KickFromOtp_CoopForfeit"] }
		,{ "event":"evt_kick_from_otp_coop_opponent_forfeit", "targets":["KickFromOtp_CoopOpponentForfeit"] }
		,{ "event":"profileSignOut", "targets":["PauseProfileSignOutWait"] }
	]
	,"states":
	[
		{
			"name":"PauseProfileSignOutWait"
			,"transitions":
			[
				{
					"event":"profileSignOutComplete"
					, "actions":[ ["invoke",["GoToTitleScreen"]]]
				}
			]
		}
		,{
			"name":"PMASkillGameCheck"
			,"onEnter":
			[
				["sendAction", ["condition", "hasPMASkillGame"]]
			]
			,"transitions":
			[
				{
					"event":"true"
					,"targets":["PMASkillGame"]
				}
				,{
					"event":"false"
					,"targets":["gameActive"]
				}
			]
		}
		,{
			"name":"PMASkillGame"
			,"transitions":
			[
				{
					"event":"advanceFromPMA"
					,"targets":["gameActive"]
				}
			]
			,"states":
			[
				{
					"name":"WaitForInstructions"
					,"transitions":
					[
						{
							"event":"showInstructions"
							,"targets":["instructionsOverlay"]
						}
					]
				}
				,{
					"name":"instructionsOverlay"
					,"onEnter":
					[
						["loadViewModel",["SkillGameInstructionsViewModel"]]
						,["loadView",["screen", "game/screens/skillGames/SkillGamePause", "", ".direction"]]
						,["sendAction", ["evt_training_allow_advance_to_game"]]
					]
					,"onExit":
					[
						["unloadView",["screen", "game/screens/skillGames/SkillGamePause"]]
						,["unloadViewModel",["SkillGameInstructionsViewModel"]]
					]
					,"transitions":
					[
						{
							"event":"resume"
							,"targets":["PMASkillGameActive"]
						}
						,{
							"event":"advanceFromPMAInstructions"
							,"targets":["PMASkillGameActive"]
						}

					]
				}
				,{
					"name":"PMASkillGameActive"
					,"onEnter":
					[	
						["sendAction", ["transitionManager", ".NavTransitionManager.TO_GAME"]]
					]
					,"transitions":
					[
						{
							"event":"showResults"
							,"targets":["resultsOverlay"]
						}
					]
				}
				,{
					"onEnter":
					[	
						["sendAction", ["transitionManager", ".NavTransitionManager.TO_FE"]]
					]
					,"states":
					[
						{
							"name":"resultsOverlay"
							,"onEnter":
							[
								["loadViewModel",["SkillGameResultsViewModel"]]
								,["loadViewModel",["SkillGamesLeaderboardViewModel"]]
								,["loadView",["screen", "game/screens/skillGames/SkillGameResults", "", ".direction"]]
							]
							,"onExit":
							[
								["unloadView",["screen", "game/screens/skillGames/SkillGameResults"]]
								,["unloadViewModel",["SkillGamesLeaderboardViewModel"]]
								,["unloadViewModel",["SkillGameResultsViewModel"]]
							]
							,"transitions":
							[
								{
									"event":"restart"
									,"targets":["PMASkillGameActive"]
								}
								,{
									"event":"advanceFromPMAResults"
									,"targets":["PMASkillGameActive"]
								}
							]
						}
					]
				}
			]
		}
		,{
			"name":"gameActive"
			,"initial":
			{
				"targets":["InGame"]
			}
			,"onEnter":
			[	
				["sendAction", ["transitionManager", ".NavTransitionManager.TO_GAME"]]
			]
			,"onExit":
			[
				["sendAction", ["transitionManager", ".NavTransitionManager.TO_FE"]]
			]
			,"transitions":
			[
				{
					"event":"quit"
					,"targets":["quit"]
					,"let":{ "direction":"back" }
				}
				,{ "event":"evt_notify_controller_disconnect", "targets":["sideSelect"] }
				,{
					"event":"evt_notify_lead_controller_changed"
					,"targets":["sideSelect"]
				}
			]
			,"states":
			[
				{
					"name":"InGame"
					,"transitions":
					[
						{ "event":"Draw","targets":["Draw"] }
						,{ "event":"HalfTime","targets":["HalfTime"] }
						,{ "event":"MatchEnded","targets":["MatchEnded"] }
						,{ "event":"PenaltyShoot","targets":["MatchDetailsPenalties"] }
						,{ "event":"MatchForfeit","targets":["MatchForfeit"] }
						,{ "event":"ForceSubstitution","targets":["teamSheetEditor"] }
					]
				}
				,{
					"name":"PostGame"
					,"states":
					[
						{
							"name":"Draw"
							,"onEnter":
							[
								["sendScreenEvent", ["UxSetFlowSubState",".eSubState.DRAW"]]
							]
						}
						,{
							"name":"HalfTime"
							,"onEnter":
							[
								["sendScreenEvent", ["UxSetFlowSubState",".eSubState.HALF_TIME"]]
							]
						}
						,{
							"name":"MatchEnded"
							,"onEnter":
							[
								["sendScreenEvent", ["UxSetFlowSubState",".eSubState.POSTGAME"]]
							]
						}
					]
					,"transitions":
					[
						{
							"event":"KickOffMatchResults"
							,"targets":["MatchDetailsEndGame"]
						}
						,{
							"event":"KickOffEndGame"
							,"targets":["matchHighlights"]
							, "let":{ "returnToMenu": "0" }
						}
						,{
							"event":"CareerMatchResults"
							,"targets":["CareerMatchResults"]
						}
						,{
							"event":"CareerMatchResultsPostGame"
							,"targets":["CareerMatchResultsPostGame"]
						}
						,{
							"event":"ManOfTheMatch"
							,"targets":["PlayerPerformanceFromGame"]
						}
						,{
							"event":"ManOfTheMatchPlayerCareer"
							,"targets":["ManOfTheMatchPlayerCareer"]
						}
						,{
							"event":"ManOfTheMatchClubs"
							,"targets":["ManOfTheMatchClubs"]
						}
						,{
							"event":"ManOfTheMatchClubsCup"
							,"targets":["ManOfTheMatchClubsCup"]
						}
						,{
							"event":"OnlineSeasonsSummary"
							,"targets":["OnlineSeasonsSummary"]
						}
						,{
							"event":"VotingMenu"
							,"targets":["VotingMenu"]
						}
					]
				}
			]
		}
		,{
			"name":"GamePaused"
			,"onEnter":
			[
				["sendAction",["updateScreen", "TM_CacheTeamSheets"]]
			]
			,"onExit":
			[
				["sendAction",["updateScreen", "TM_ClearTeamSheetsCache"]]
			]
			,"transitions":
			[
				{ "event":"resume", "targets":["gameActive"], "let":{ "direction":"back" } }
				,{ "event":"evt_notify_controller_disconnect", "targets":["sideSelect"] }
				,{ "event":"quit", "targets":["quit"] }
			]
			,"states":
			[
				{
					"name":"PauseMenu"
					,"initial":
					{
						"targets":["PauseMenuIdle"]
					}
					,"onEnter":
					[
						["loadViewModel",["FluxViewModel"]]
						,["loadViewModel",["PauseHubViewModel", ".isGamePaused"]]
						,["loadViewModel",["StartingXIViewModel"]]
						,["loadViewModel",["easfcRecommendViewModel", "1"]]
						,["loadView",["screen", "game/screens/fluxHub/FluxHub", "", ".direction"]]
						,["loadView", ["widget", "game/components/FIFAScoreClock.swf"]]
					]
					,"onExit":
					[
						["unloadView",["screen", "game/screens/fluxHub/FluxHub"]]
						,["unloadViewModel",["easfcRecommendViewModel"]]
						,["unloadViewModel",["StartingXIViewModel"]]
						,["unloadViewModel",["PauseHubViewModel"]]
						,["unloadViewModel",["FluxViewModel"]]
						,["unloadView", ["widget", "game/components/FIFAScoreClock.swf"]]
					]
					,"states":
					[
						{
							"states":
							[
								{
									"name":"PauseMenuIdle"
									,"onEnter":
									[
										["loadViewModel", ["ScreenTimeoutViewModel", "FADE_PAUSE_MENU"]]
									]
									,"onExit":
									[
										["unloadViewModel", ["ScreenTimeoutViewModel"]]
									]
								}
								,{
									"name":"PauseMenuNoScreenSaver"
									,"transitions":
									[
										{"event":"evt_state_idle", "targets":["PauseMenuIdle"]}
										,{"event":"evt_popup_exit", "targets":["PauseMenuIdle"]}
									]
								}
							]
							,"transitions":
							[
								{"event":"evt_countdown_done", "targets":["StadiumPan"]}
								,{"event":"evt_no_screensaver", "targets":["PauseMenuNoScreenSaver"]}
								,{"event":"evt_popup_enter", "targets":["PauseMenuNoScreenSaver"]}
								,{"event":"TrainerSettings", "targets":["TrainerSettings"]}
								,{
									"event":"CareerQuitMatch"
									,"targets":["QuitMatchCareerDecision"]
								}
								,{
									"event":"MutualOnlineQuit"
									,"actions":[ ["sendScreenEvent", ["QuitMatchManualOnline"]] ]
								}
								,{
									"event":"OnlineEndMatchQuit"
									,"targets":["QuitEndMatchOnline"]
								}
								,{
									"event":"OnlineQuit"
									,"targets":["QuitMatchOnline"]
								}
								,{
									"event":"QuitMatch"
									,"targets":["QuitMatch"]
								}
								,{
									"event":"RestartMatch"
									,"targets":["RestartMatch"]
								}
								,{
									"event":"RestartWithNewTeams"
									,"targets":["RestartWithNewTeams"]
								}
								,{
									"event":"SimRestofMatch"
									,"targets":["SimRestofMatch"]
								}
								,{
									"event":"adaptiveDifficultyDetectedPopup"
									,"actions":[ ["sendAction",["adaptiveDifficultyDetectedPopup"]] ]
								}
								,{
									"event":"adaptiveDifficultyUpPopup"
									,"actions":[ ["sendAction",["adaptiveDifficultyUpPopup"]] ]
								}
								,{
									"event":"adaptiveDifficultyDownPopup"
									,"actions":[ ["sendAction",["adaptiveDifficultyDownPopup"]] ]
								}
								,{
									"event":"OnlineSeasonsSummary"
									,"targets":["OnlineSeasonsSummary"]
								}
								,{
									"event":"REMOTE_PLAY"
									,"targets":["remotePlay"]
								}
								,{
									"event":"openMuteScreen"
									,"targets":["MuteScreenFromPause"]
								}
								,{
									"event":"enterMatchDayTab"
									,"actions":
									[
										["unloadView",["widget", "game/components/FIFAScoreClock.swf"]]
									]
								}
								,{
									"event":"exitMatchDayTab"
									,"actions":
									[
										["loadView",["widget", "game/components/FIFAScoreClock.swf"]]
									]
								}
								,{
									"event":"VotingMenu"
									,"targets":["VotingMenu"]
								}
							]
						}
						,{
							"name":"TrainerSettings"
							,"onEnter":
							[
								["loadViewModel", ["TrainerSettingsViewModel"]]
							]
							,"onExit":
							[
								["unloadViewModel", ["TrainerSettingsViewModel"]]
							]
							,"transitions":
							[
								{"event":"back", "targets":["PauseMenuIdle"],"let":{ "direction":"back" }}
							]
						}
						,{
							"name":"RestartMatch"
							,"onEnter":
							[
								["loadView", ["popup", "RestartConf", "RestartConf|YesRestart|restart|Cancel|back", "-1|1"]]
							]
							,"onExit":
							[
								["unloadView", ["popup", "RestartConf"]]
							]
							,"transitions":
							[
								{
									"event":"restart"
									,"actions":[ ["sendScreenEvent", ["RestartMatch"]] ]
									,"targets":["gameActive"]
									,"let":{ "direction":"back" }
								}
								,{
									"event":"back"
									,"targets":["PauseMenuIdle"]
								}
							]
						}
						,{
							"name":"RestartWithNewTeams"
							,"onEnter":
							[
								["loadView", ["popup", "RestartWithNewTeamsPopup", "Popup_restartWithNewTeams|YesRestart|restart|Cancel|cancel", "-1|1"]]
							]
							,"onExit":
							[
								["unloadView", ["popup", "RestartWithNewTeamsPopup"]]
							]
							,"transitions":
							[
                                {
                                    "event":"restart"
                                    ,"actions":
                                    [
                                        ["sendAction", ["setStadiumPosition", ".StadiumFECameras.STADIUM_FE_CAMERA_STEP_1"] ]
                                        ,["sendAction", ["restartWithNewTeams"]]
                                        ,["sendScreenEvent", ["UxSetFlowSubState",".eSubState.PREGAME"]]    
                                    ]
                                }
                                ,{
                                    "event":"cancel"
                                    ,"targets":["PauseMenuIdle"]
                                }
                            ]
						}
						,{
							"name":"QuitMatch"
							,"initial":
							{
								"targets":["Initial_QuitMatch"]
							}
							,"onEnter":
							[
								["sendScreenEvent", ["QuitMatch"]]
							]
							,"states":
							[
								{
									"name":"Initial_QuitMatch"
									,"transitions":
									[
										{
											"event":"DemoVersion_QuitMatch"
											,"targets":["DemoVersion_QuitMatch"]
										}
										,{
											"event":"FinalVersion_QuitMatch"
											,"targets":["FinalVersion_QuitMatch"]
										}
										,{
											"event":"ADIFF_QuitToConf"
											,"targets":["ADIFF_QuitToConf"]
										}
										,{
											"event":"IntroMatch_QuitToConf"
											,"targets":["IntroMatch_QuitToConf"]
										}
									]
								}
								,{
									"name":"DemoVersion_QuitMatch"
									,"onEnter":
									[
										["loadView", ["popup", "QuitMatch", "DEMO_QuitToConf|YesQuit|advance|Cancel|back", "-1|1"]]
									]
									,"onExit":
									[
										["unloadView", ["popup", "QuitMatch"]]
									]
								}
								,{
									"name":"FinalVersion_QuitMatch"
									,"onEnter":
									[
										["loadView", ["popup", "QuitMatch", "QuitToConf|YesQuit|advance|Cancel|back", "-1|1"]]
									]
									,"onExit":
									[
										["unloadView", ["popup", "QuitMatch"]]
									]
								}
								,{
									"name":"ADIFF_QuitToConf"
									,"onEnter":
									[
										["loadView", ["popup", "QuitMatch", "ADIFF_QuitToConf|YesQuit|advance|Cancel|back", "-1|1"]]
									]
									,"onExit":
									[
										["unloadView", ["popup", "QuitMatch"]]
									]
								}
								,{
									"name":"IntroMatch_QuitToConf"
									,"onEnter":
									[
										["loadView", ["popup", "QuitMatch", "QuitToConfSimple|YesQuit|advance|Cancel|back", "-1|1"]]
									]
									,"onExit":
									[
										["unloadView", ["popup", "QuitMatch"]]
									]
								}
							]
							,"transitions":
							[
								{
									"event":"advance"
									,"actions":
									[ 
										["sendAction", ["backendExit"]]
										,["sendScreenEvent", ["ProcessQuitMatch"]] 
									]
								}
								,{
									"event":"back"
									,"targets":["PauseMenuIdle"]
								}
							]
						}
						,{
							"name":"QuitEndMatchOnline"
							,"initial":
							{
								"targets":["Initial_QuitEndMatchOnline"]
							}
							,"onEnter":
							[
								["sendScreenEvent", ["QuitEndMatchOnline"]]
							]
							,"states":
							[
								{
									"name":"Initial_QuitEndMatchOnline"
									,"transitions":
									[
										{
											"event":"OnlineClubs_QuitEndMatchOnline"
											,"targets":["OnlineClubs_QuitEndMatchOnline"]
										}
										,{
											"event":"Other_QuitEndMatchOnline"
											,"targets":["Other_QuitEndMatchOnline"]
										}
									]
								}
								,{
									"name":"OnlineClubs_QuitEndMatchOnline"
									,"onEnter":
									[
										["loadView", ["popup", "QuitEndMatchOnline", "QuitConfGeneral|TXT_ONLINE_RETURNTOMATCHLOBBY|advance|Cancel|back", "-1|1"]]
									]
									,"onExit":
									[
										["unloadView", ["popup", "QuitEndMatchOnline"]]
									]
								}
								,{
									"name":"Other_QuitEndMatchOnline"
									,"onEnter":
									[
										["loadView", ["popup", "QuitEndMatchOnline", "QuitConfGeneral|QuitGame|advance|Cancel|back", "-1|1"]]
									]
									,"onExit":
									[
										["unloadView", ["popup", "QuitEndMatchOnline"]]
									]
								}
							]
							,"transitions":
							[
								{
									"event":"advance"
									,"actions":
									[ 
										["sendAction", ["backendExit"]]
										,["sendScreenEvent", ["ProcessQuitEndMatchOnline"]] 
									]
								}
								,{
									"event":"back"
									,"targets":["PauseMenuIdle"]
								}
								,{
									"event":"OnlineSeasonsSummary"
									,"targets":["OnlineSeasonsSummary"]
								}
							]
						}
						,{
							"name":"QuitMatchOnline"
							,"initial":
							{
								"targets":["Initial_QuitMatchOnline"]
							}
							,"onEnter":
							[
								["sendScreenEvent", ["QuitMatchOnline"]]
							]
							,"states":
							[
								{
									"name":"Initial_QuitMatchOnline"
									,"transitions":
									[
										{
											"event":"Ranked_QuitMatchOnline"
											,"targets":[ "Ranked_QuitMatchOnline" ]
										}
										,{
											"event":"Unranked_QuitMatchOnline"
											,"targets":[ "Unranked_QuitMatchOnline" ]
										}
									]
								}
								,{
									"name":"Ranked_QuitMatchOnline"
									,"onEnter":
									[
										["loadView", ["popup", "QuitMatchOnline", "QuitCreatedSession|NO|back|YES|advance"]]
									]
									,"onExit":
									[
										["unloadView", ["popup", "QuitMatchOnline"]]
									]
								}
								,{
									"name":"Unranked_QuitMatchOnline"
									,"onEnter":
									[
										["loadView", ["popup", "QuitMatchOnline", "QuitCreatedSession_Unranked|NO|back|YES|advance"]]
									]
									,"onExit":
									[
										["unloadView", ["popup", "QuitMatchOnline"]]
									]
								}
							]
							,"transitions":
							[
								{
									"event":"advance"
									,"actions":
									[ 
										["sendAction", ["backendExit"]]
										,["sendScreenEvent", ["ProcessQuitMatchOnline"]] 
									]
								}
								,{
									"event":"back"
									,"targets":["PauseMenuIdle"]
								}
							]
						}
						,{
							"name":"QuitMatchCareerDecision"
							,"onEnter": 
							[
								["sendScreenEvent", ["QuitMatchCareerCheck"]] 
							]
							,"transitions":
							[
								{ "event":"QuitMatchCareer", "targets":["QuitMatchCareer"] }
								,{ "event":"QuitCareerInvalidController", "targets":["QuitCareerInvalidController"] }
							]
						}
						,{
							"name":"QuitCareerInvalidController"
							,"onEnter":
							[
								["loadView", ["popup", "QuitCareerInvalidController", "WarningMouseNotSoported|Ok|advance"]]
							]
							,"onExit":
							[
								["unloadView", ["popup", "QuitCareerInvalidController"]]
							]
							,"transitions":
							[
								{
									"event":"advance"
									,"targets":["PauseMenuIdle"]
								}
							]
						}
						,{
							"name":"QuitMatchCareer"
							,"onEnter":
							[
								["loadView", ["popup", "QuitMatchCareer", "ForfeitConf|YesForfeit|advance|Cancel|back", "-1|1"]]
							]
							,"onExit":
							[
								["unloadView", ["popup", "QuitMatchCareer"]]
							]
							,"transitions":
							[
								{
									"event":"advance"
									,"actions":
									[ 
										["sendAction", ["backendExit"]]
										,["sendScreenEvent", ["QuitMatchCareer"]] 
									]
								}
								,{
									"event":"back"
									,"targets":["PauseMenuIdle"]
								}
								,{
									"event":"CareerMatchResults"
									,"targets":["CareerMatchResults"]
								}
							]
						}
						,{
							"name":"SimRestofMatch"
							,"onEnter":
							[
								["loadView", ["popup", "SimRestofMatch", "SimMatchConf|YesSimMatch|advance|Cancel|back", "-1|1"]]
							]
							,"onExit":
							[
								["unloadView", ["popup", "SimRestofMatch"]]
							]
							,"transitions":
							[
								{
									"event":"advance"
									,"actions":
									[
										["sendAction", ["backendExit"]]
										,["sendScreenEvent", ["UxSetGameOption", "10"]]
										,["sendScreenEvent", ["UxSetFlowSubState", ".eSubState.UNLOADING"]]
										,["sendScreenEvent", ["CareerSimMatch"]]
										,["sendAction", ["quit"]]
									]
