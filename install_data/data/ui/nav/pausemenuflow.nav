						,["unloadViewModel",["VoipViewModel"]]
					]
					,"states":
					[
						{
							"name":"MuteScreenFromPause"
							,"transitions":
							[
								{
									"event":"back"
									,"targets":["PauseMenu"]
								}
							]
						}					
						,{
							"name":"MuteScreenFromManOfTheMatchClubs"
							,"transitions":
							[
								{
									"event":"back"
									,"targets":["ManOfTheMatchClubs"]
								}
							]
						}					
						,{
							"name":"MuteScreenFromManOfTheMatchClubsCup"
							,"transitions":
							[
								{
									"event":"back"
									,"targets":["ManOfTheMatchClubsCup"]
								}
							]
						}
						,{
							"name":"MuteScreenFromPlayerPerformancePause"
							,"transitions":
							[
								{
									"event":"back"
									,"targets":["PlayerPerformanceFromPause"]
								}
							]
						}	
						,{
							"name":"MuteScreenFromOnlineSeasonsSummary"
							,"transitions":
							[
								{
									"event":"back"
									,"targets":["OnlineSeasonsSummary"]
								}
							]
						}					
					]
				}
				,{
					"name":"MatchForfeit"
					,"onEnter":
					[
						["sendScreenEvent", ["UxSetFlowSubState",".eSubState.POSTGAME"]]	
						, ["loadView", ["screen", "game/screens/postGameFlow/MatchForfeit"]]
					]
					,"onExit":
					[
						["unloadView", ["screen", "game/screens/postGameFlow/MatchForfeit"]]
					]
					,"transitions":
					[
						{ "event":"advance", "targets":["PauseMenu"] }
					]
				}
			]
		}
		,{
			"name":"OnlineInGameDisconnectFlow"
			,"type":"external"
			,"file":"/online/onlineInGameDisconnectFlow.nav"
			,"inputs":
			{
				"ConnectionWithOpponentLostPopup":"in_ConnectionWithOpponentLostPopup"
				,"ConnectionWithOpponentLostEomPopup":"in_ConnectionWithOpponentLostEomPopup"
				,"MismatchingSquadPopup":"in_MismatchingSquadPopup"
				,"MismatchingSquadEomPopup":"in_MismatchingSquadEomPopup"
				,"IdlePlayerPopup":"in_IdlePlayerPopup"
				,"IdlePlayerEomPopup":"in_IdlePlayerEomPopup"
				,"MismatchingChangelistPopup":"in_MismatchingChangelistPopup"
				,"MismatchingChangelistEomPopup":"in_MismatchingChangelistEomPopup"
				,"OnlineDesyncPopup":"in_OnlineDesyncPopup"
				,"KickFromOtp_CaptainKick":"in_KickFromOtp_CaptainKick"
				,"KickFromOtp_ClubsForfeit":"in_KickFromOtp_ClubsForfeit"
				,"KickFromOtp_ClubsOpponentForfeit":"in_KickFromOtp_ClubsOpponentForfeit"
				,"KickFromOtp_CoopForfeit":"in_KickFromOtp_CoopForfeit"
				,"KickFromOtp_CoopOpponentForfeit":"in_KickFromOtp_CoopOpponentForfeit"
			}
			,"outputs":
			{
				"out_PauseMenu":"PauseMenu"
				,"out_Quit":"quit"
			}
		}
	]
}
